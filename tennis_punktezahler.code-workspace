{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "emeraldwalk.runonsave": {
      "commands": [
        {
          "match": ".*",
          "cmd": "npm run push",
        },
      ],
    },
  },
  "keybindings": [
    {
      "key": "ctrl+shift+u",
      "command": "workbench.action.tasks.runTask",
      "args": "npm push",
    },
  ],
}
